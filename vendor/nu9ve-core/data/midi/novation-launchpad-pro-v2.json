{
  "schemaVersion": 2,
  "id": "novation-launchpad-pro",
  "name": "Launchpad Pro",
  "vendor": "Novation",
  "ports": [
    "Launchpad Pro Standalone Port"
  ],
  "evidence": "Launchpad Pro (first model, device inquiry family 0x51 0x00, firmware 01 08 02) in Programmer layout, CoreMIDI on 2026-11-27: pads 11 and 88 sent Note On with velocity, Up sent CC 0x5B 7F/00 and the lowest right button CC 0x13. Still colors (5, 13, 21, 45, 53), SysEx 0x23 flash and 0x28 pulse were seen on the unit. The other addresses follow Novation's Programmer's Reference for the Launchpad Pro.",
  "notes": [
    "Programmer layout: pad notes are row × 10 + column from the bottom left (11–88); the four edges send CC.",
    "Pads are velocity sensitive: a light press can send velocity 1. Pads also send channel pressure, which this reader ignores.",
    "Lights take the same address on channel 1; the value is a color from the 128-color palette."
  ],
  "layout": [
    10,
    10
  ],
  "pageControl": "top-5",
  "feedback": {
    "kind": "palette",
    "allControls": true,
    "init": [
      "F0 00 20 29 02 10 2C 03 F7"
    ],
    "palette": {
      "white": 3,
      "white.dim": 1,
      "red": 5,
      "red.dim": 7,
      "orange": 9,
      "orange.dim": 11,
      "yellow": 13,
      "yellow.dim": 15,
      "green": 21,
      "green.dim": 23,
      "cyan": 37,
      "cyan.dim": 39,
      "blue": 45,
      "blue.dim": 47,
      "purple": 49,
      "purple.dim": 51,
      "pink": 53,
      "pink.dim": 55
    },
    "flash": "F0 00 20 29 02 10 23 {number} {value} F7",
    "pulse": "F0 00 20 29 02 10 28 {number} {value} F7",
    "evidence": "Colors 5, 13, 21, 45 and 53, flash and pulse seen on the unit on 2026-11-27. The init message selects Programmer layout (reference manual)."
