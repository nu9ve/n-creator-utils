{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nu9ve:stalker-coordinated-retitle:1",
  "title": "Coordinated completed Stalker retitle; producer adoption pending",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/capabilities"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "schema",
        "operation_id",
        "path",
        "session_id",
        "expected_manifest_sha256",
        "project",
        "catalog_id"
      ],
      "properties": {
        "schema": {
          "const": "stalker-coordinated-retitle/1"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "expected_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project": {
          "type": "object",
          "required": [
            "version",
            "name",
            "country"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "country": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "catalog_id": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "schema",
        "operation_id",
        "session_id",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "stalker-retitle-result/1"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "status": {
          "enum": [
            "not_found",
            "pending",
            "applied",
            "failed"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "project": {
          "type": "object",
          "required": [
            "version",
            "name",
            "country"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "country": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "previous_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "project",
              "previous_manifest_sha256",
              "manifest_sha256"
            ]
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "required": [
        "schema",
        "capabilities"
      ],
      "properties": {
        "schema": {
          "const": "stalker-capabilities/1"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
