{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nu9ve:creator-media-handoff:1",
  "title": "Creator media library handoff (draft, not yet adopted)",
  "type": "object",
  "required": [
    "schema",
    "handoff_id",
    "created_at",
    "project_id",
    "profile_id",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "creator-media-handoff/1"
    },
    "handoff_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "project_id": {
      "$ref": "#/$defs/uuid"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "clipper_profile": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\x00])(?!.*\\/$).+$"
    },
    "member": {
      "type": "object",
      "required": [
        "relative_path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_path": {
          "$ref": "#/$defs/relative_path"
        },
        "volume_relative_path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "volume_id",
        "relative_path",
        "role",
        "receipt_id"
      ],
      "properties": {
        "volume_id": {
          "$ref": "#/$defs/uuid"
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "role": {
          "enum": [
            "work",
            "archive"
          ]
        },
        "receipt_id": {
          "$ref": "#/$defs/uuid"
        },
        "path_kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "content_revision",
        "kind",
        "order",
        "members",
        "locations"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/uuid"
        },
        "content_revision": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "file",
            "stalker_session",
            "camera_bundle",
            "delivery"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "capture_session_id": {
          "$ref": "#/$defs/uuid"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "capture_time": {
          "$ref": "#/$defs/capture_time"
        },
        "clipper_profile": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "editable_members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relative_path"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "stalker_session"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "capture_session_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "members": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "capture_time": {
      "type": "object",
      "required": [
        "original",
        "provenance",
        "originals",
        "captured_at_absolute",
        "time_zone",
        "offset_seconds"
      ],
      "properties": {
        "original": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "originals": {
          "type": "object"
        },
        "captured_at_absolute": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "time_zone": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -86400,
          "maximum": 86400
        }
      }
    }
  }
}
