{
  "contract": "nuun-accumulation-rules/1",
  "note": "Reglas de acumulados como datos (docs/features/storage-map.md#acumulados). Una regla nunca borra: sólo reconoce. `names` se busca al recorrer las raíces de código; `paths` y `children_of` son relativas a la carpeta de la persona. Todas las condiciones dadas deben cumplirse.",
  "rules": [
    {"id": "rust-target", "kind": "rust", "label": "Rust target/", "names": ["target"],
     "inside_any": ["CACHEDIR.TAG", ".rustc_info.json"], "sibling_any": ["Cargo.toml"],
     "regenerates": "yes", "cost": "build", "cost_note": "Se recompila; horas en release", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "next", "kind": "js-build", "label": "Next .next/", "names": [".next"], "sibling_any": ["package.json"],
     "regenerates": "yes", "cost": "build", "cost_note": "Se reconstruye con el build", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "turbo", "kind": "js-build", "label": "Turbo .turbo/", "names": [".turbo"], "sibling_any": ["package.json"],
     "regenerates": "yes", "cost": "build", "cost_note": "Caché de Turbo; se rehace", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "node-modules", "kind": "node-modules", "label": "node_modules/", "names": ["node_modules"], "sibling_any": ["package.json"],
     "regenerates": "yes", "cost": "network", "cost_note": "npm/pnpm install (red)", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "python-venv", "kind": "python", "label": "Entorno de Python", "names": [".venv", "venv"], "inside_any": ["pyvenv.cfg"],
     "regenerates": "yes", "cost": "network", "cost_note": "Se recrea e instala (red)", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "pycache", "kind": "python", "label": "__pycache__", "names": ["__pycache__"], "aggregate": "project",
     "regenerates": "yes", "cost": "instant", "cost_note": "Python lo recrea al importar", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "swiftpm-build", "kind": "xcode", "label": "SwiftPM .build/", "names": [".build"], "sibling_any": ["Package.swift"],
     "regenerates": "yes", "cost": "build", "cost_note": "swift build", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "xcode-derived-data", "kind": "xcode", "label": "Xcode DerivedData", "paths": ["Library/Developer/Xcode/DerivedData"], "children": true,
     "regenerates": "yes", "cost": "build", "cost_note": "Xcode lo reconstruye", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "packaging", "kind": "packaging", "label": "Empaquetado dist/ y build/", "names": ["dist", "build"],
     "contains_ext_any": [".app", ".dmg", ".msix", ".msixbundle", ".appx", ".pkg", ".zip", ".whl", ".exe", ".tar.gz"],
     "regenerates": "depends", "cost": "build", "cost_note": "Depende: una build publicada puede no volver a salir igual", "risk": "medium", "action": "trash", "confirmations": 1},
    {"id": "git", "kind": "git", "label": "Objetos de git", "names": [".git"], "git": true,
     "regenerates": "partial", "cost": "local", "cost_note": "git gc y git worktree prune, nunca a la Papelera", "risk": "high", "action": "manual", "confirmations": 2},
    {"id": "model-cache", "kind": "model-cache", "label": "Modelos y cachés de ML", "paths": [".cache/huggingface", ".cache/torch", ".ollama/models"],
     "regenerates": "yes", "cost": "network", "cost_note": "Se vuelven a descargar (red, pueden ser GiB)", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "user-caches", "kind": "caches", "label": "~/Library/Caches", "children_of": ["Library/Caches"], "min_bytes": 52428800,
     "regenerates": "yes", "cost": "network", "cost_note": "La app la rehace; una app abierta la vuelve a llenar", "risk": "low", "action": "trash", "confirmations": 1},
    {"id": "docker", "kind": "docker", "label": "Docker (disco de la VM)", "paths": ["Library/Containers/com.docker.docker/Data/vms"],
     "regenerates": "yes", "cost": "network", "cost_note": "docker system prune desde Docker; nunca a mano", "risk": "medium", "action": "manual", "confirmations": 1},
    {"id": "nove-update-backups", "kind": "app-backups", "label": "Respaldos de actualización de nove", "app": "nove",
     "paths": ["Library/Application Support/nove-update-backups"], "children": true,
     "regenerates": "no", "cost": "none", "cost_note": "No se regenera: es la versión anterior instalada", "risk": "high", "action": "trash", "confirmations": 2},
    {"id": "nuun-app-backups", "kind": "app-backups", "label": "Respaldos de apps que instaló nüün", "app": "nuun",
     "paths": ["Library/Application Support/nu9ve/app-backups"], "children": true,
     "regenerates": "no", "cost": "none", "cost_note": "No se regenera: es la versión anterior instalada", "risk": "high", "action": "trash", "confirmations": 2}
  ]
}
