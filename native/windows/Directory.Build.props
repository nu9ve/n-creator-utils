<Project>
  <!-- nüün para Windows. Mismo stack y versiones que nove (apps/windows): .NET 10,
       Windows App SDK 1.8.260921001, xUnit 2.9.3. No añadir paquetes sin registrar
       la decisión en docs/platforms/windows.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Company>nu9ve</Company>
    <Product>nüün</Product>
    <SatelliteResourceLanguages>es-MX;es;en-US;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
